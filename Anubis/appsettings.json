{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=anubis.db"
  },
  "Email": {
    "Provider": "Smtp",
    "FromAddress": "",
    "FromName": "Anubis",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "Auto",
      "Username": "",
      "Password": ""
    }
  },
  "Anubis": {
    "AdminEmail": "admin@anubis.local",
    "AdminPassword": "",
    "AllowRegistration": true,
    "RequireConfirmedEmail": false,
    "Issuer": "",
    "ApiScope": "anubis-api",
    "ApiResource": "anubis-api",
    "AccessTokenLifetimeMinutes": 60,
    "IdentityTokenLifetimeMinutes": 20,
    "AuthorizationCodeLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 14,
    "ConsentCookieLifetimeMinutes": 10,
    "Clients": [],
    "General": {
      "ServerName": "Anubis"
    },
    "Security": {
      "PasswordMinLength": 12,
      "PasswordRequireDigit": true,
      "PasswordRequireLowercase": true,
      "PasswordRequireUppercase": true,
      "PasswordRequireNonAlphanumeric": false,
      "LockoutMaxFailedAttempts": 5,
      "LockoutMinutes": 15,
      "SessionLifetimeHours": 8,
      "SlidingSession": true,
      "MaxPasskeysPerUser": 20
    },
    "Appearance": {
      "LogoPath": "data:image/svg+xml;base64,",
      "FaviconPath": "data:image/svg+xml;base64,",
      "FontFamily": "",
      "Light": { "Primary": "", "Secondary": "", "Background": "", "Foreground": "" },
      "Dark": { "Primary": "", "Secondary": "", "Background": "", "Foreground": "" }
    }
  }
}
