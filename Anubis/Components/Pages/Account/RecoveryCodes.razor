@page "/mfa/recovery-codes"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using k6labs.Anubis.Identity

@inject UserManager<User> UserManager
@inject NavigationManager Navigation

<AppPageTitle Text="@(Translations.RecoveryCodes_Title)" />

<Stack Gap="Gap.Large">
    <PageHeader Title="@Translations.RecoveryCodes_Title" Description="@Translations.RecoveryCodes_PageDescription" />
    <Stack Gap="Gap.Medium">
        @if (codes is not null)
        {
            <RecoveryCodesList Codes="codes" />
            <Button Href="/mfa">@Translations.RecoveryCodes_Saved</Button>
        }
        else
        {
            <Typography>@Translations.RecoveryCodes_Warning.Format(AuthenticatorSetup.RecoveryCodeCount)</Typography>
            <form method="post" @formname="generate-codes" @onsubmit="GenerateAsync">
                <Stack Direction="Direction.Row" Gap="Gap.Medium" Align="Align.Center" Wrap="true">
                    <AntiforgeryToken />
                    <Button Type="submit" Icon="@AppIcons.Refresh">
                        @Translations.RecoveryCodes_Generate
                    </Button>
                    <Button Variant="ButtonVariant.Ghost" Href="/mfa">@Translations.Common_Cancel</Button>
                </Stack>
            </form>
        }
    </Stack>
</Stack>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private User? user;
    private IEnumerable<string>? codes;

    protected override async Task OnInitializedAsync()
    {
        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null || !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            Navigation.NavigateTo("/passkeys?status=mfa-required-for-codes", forceLoad: true);
        }
    }

    private async Task GenerateAsync()
    {
        if (user is null || !await UserManager.GetTwoFactorEnabledAsync(user))
        {
            return;
        }

        codes = await UserManager.GenerateNewTwoFactorRecoveryCodesAsync(user, AuthenticatorSetup.RecoveryCodeCount);
    }
}
