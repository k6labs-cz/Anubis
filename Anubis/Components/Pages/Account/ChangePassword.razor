@page "/account/change-password"
@attribute [Authorize]

@using k6labs.Anubis.Localization
@using Microsoft.AspNetCore.Authorization

@inject UserManager<User> UserManager
@inject Identity.PasswordPolicy PasswordPolicy
@inject SignInManager<User> SignInManager

<AppPageTitle Text="@(Translations.Account_ChangePassword)" />

<Stack Gap="Gap.Large">
    <PageHeader Title="@Translations.Account_ChangePassword" Description="@Translations.ChangePassword_Description.Format(PasswordPolicy.MinLength)" />

    <EditForm Model="model" method="post" OnValidSubmit="SubmitAsync" FormName="changePassword">
        <Stack Gap="Gap.Medium">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(message))
            {
                <Alert Severity="@messageSeverity" Title="@messageTitle">
                    @message
                </Alert>
            }

            <FormText @bind-Value="model.CurrentPassword" Label="@Translations.ChangePassword_Current" name="model.CurrentPassword" autocomplete="current-password" Id="currentPassword" Type="password" />

            <FormText @bind-Value="model.NewPassword" Label="@Translations.Common_NewPassword" name="model.NewPassword" autocomplete="new-password" Id="newPassword" Type="password" />

            <FormText @bind-Value="model.ConfirmPassword" Label="@Translations.Common_ConfirmNewPassword" name="model.ConfirmPassword" autocomplete="new-password" Id="confirmPassword" Type="password" />

            <Button Type="submit" Icon="@AppIcons.Key">
                @Translations.ChangePassword_Submit
            </Button>
        </Stack>
    </EditForm>
</Stack>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [SupplyParameterFromForm(FormName = "changePassword")]
    private ChangePasswordModel model { get; set; } = default!;

    protected override void OnInitialized() => model ??= new();

    private string? message;
    private string messageTitle = string.Empty;
    private AlertSeverity messageSeverity = AlertSeverity.Success;

    private async Task SubmitAsync()
    {
        if (AuthenticationState is null)
        {
            return;
        }

        message = null;

        var state = await AuthenticationState;
        var user = await UserManager.GetUserAsync(state.User);

        if (user is null)
        {
            messageTitle = Translations.Common_Error;
            messageSeverity = AlertSeverity.Danger;
            message = Translations.Common_UserNotFound;
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, model.CurrentPassword, model.NewPassword);

        if (result.Succeeded)
        {
            await SignInManager.RefreshSignInAsync(user);
            model.CurrentPassword = string.Empty;
            model.NewPassword = string.Empty;
            model.ConfirmPassword = string.Empty;
            messageTitle = Translations.Reset_DoneTitle;
            messageSeverity = AlertSeverity.Success;
            message = Translations.ChangePassword_Done;
        }
        else
        {
            messageTitle = Translations.ChangePassword_Failed;
            messageSeverity = AlertSeverity.Danger;
            message = string.Join(" ", result.Errors.Select(e => e.Description));
        }
    }

    public sealed class ChangePasswordModel
    {
        [LRequired(nameof(Translations.Validation_CurrentPasswordRequired))]
        public string CurrentPassword { get; set; } = string.Empty;

        [LRequired(nameof(Translations.Validation_PasswordRequired))]
        public string NewPassword { get; set; } = string.Empty;

        [LRequired(nameof(Translations.Validation_ConfirmPasswordRequired))]
        [LCompare(nameof(NewPassword), nameof(Translations.Validation_PasswordsDoNotMatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
