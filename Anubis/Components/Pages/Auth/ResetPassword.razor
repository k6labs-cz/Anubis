@page "/reset-password"

@using k6labs.Anubis.Localization

@inject UserManager<User> UserManager
@inject Identity.PasswordPolicy PasswordPolicy

@* Opening the link only shows the form; the password changes on POST, so link
   scanners in mail clients can't use up the one-time link. *@

<AppPageTitle Text="@(Translations.Reset_PageTitle)" />

<Container MaxWidth="28rem">
    <Stack Gap="Gap.Large">
        <Card>
            <Header>
                <Stack Gap="Gap.XSmall">
                    <Typography Variant="TextVariant.Title" As="TextElement.H1">@Translations.Reset_Title</Typography>
                    <Typography Variant="TextVariant.Small" Tone="Tone.Muted">@Email</Typography>
                </Stack>
            </Header>
            <ChildContent>
                <Stack Gap="Gap.Medium">
                    @if (done)
                    {
                        <Alert Severity="AlertSeverity.Success" Title="@Translations.Reset_DoneTitle">
                            @Translations.Reset_DoneText
                        </Alert>
                        <Stack Gap="Gap.Medium">
                            <Button Href="/login" Block="true">@Translations.Common_SignIn</Button>
                        </Stack>
                    }
                    else if (string.IsNullOrEmpty(Email) || AccountEmailService.Decode(Code) is null)
                    {
                        <Alert Severity="AlertSeverity.Danger" Title="@Translations.Reset_InvalidLinkTitle">
                            @Translations.Reset_InvalidLinkText
                        </Alert>
                        <Typography Tone="Tone.Muted" Align="TextAlign.Center"><a href="/forgot-password">@Translations.Reset_RequestNew</a></Typography>
                    }
                    else
                    {
                        <EditForm Model="model" method="post" OnValidSubmit="SubmitAsync" FormName="reset-password">
                            <Stack Gap="Gap.Medium">
                                <DataAnnotationsValidator />

                                @if (!string.IsNullOrEmpty(error))
                                {
                                    <Alert Severity="AlertSeverity.Danger" Title="@Translations.Reset_FailedTitle">
                                        @error
                                    </Alert>
                                }

                                <FormText @bind-Value="model.Password" name="model.Password" Label="@Translations.Common_NewPassword" Placeholder="@Translations.Common_NewPasswordPlaceholder.Format(PasswordPolicy.MinLength)" autocomplete="new-password" autofocus Id="password" Type="password" />

                                <FormText @bind-Value="model.ConfirmPassword" name="model.ConfirmPassword" Label="@Translations.Common_ConfirmNewPassword" autocomplete="new-password" Id="confirmPassword" Type="password" />

                                <Button Block="true" Type="submit" Icon="@AppIcons.Key">
                                    @Translations.Reset_Submit
                                </Button>
                            </Stack>
                        </EditForm>
                    }
                </Stack>
            </ChildContent>
        </Card>
    </Stack>
</Container>

@code {
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    public string? Code { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetPasswordModel model { get; set; } = default!;

    private bool done;
    private string? error;

    protected override void OnInitialized() => model ??= new();

    private async Task SubmitAsync()
    {
        var invalidLink = Translations.Reset_LinkExpired;

        var token = AccountEmailService.Decode(Code);
        var user = string.IsNullOrEmpty(Email) ? null : await UserManager.FindByEmailAsync(Email);
        if (user is null || token is null)
        {
            error = invalidLink;
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, token, model.Password);
        if (!result.Succeeded)
        {
            error = result.Errors.Any(e => e.Code == nameof(IdentityErrorDescriber.InvalidToken))
                ? invalidLink
                : string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Proving access to the mailbox also lifts a lockout from failed password attempts.
        await UserManager.ResetAccessFailedCountAsync(user);
        if (await UserManager.IsLockedOutAsync(user) && user.LockoutEnd < DateTimeOffset.UtcNow.AddYears(1))
        {
            await UserManager.SetLockoutEndDateAsync(user, null);
        }

        done = true;
    }

    public sealed class ResetPasswordModel
    {
        [LRequired(nameof(Translations.Validation_PasswordRequired))]
        public string Password { get; set; } = string.Empty;

        [LRequired(nameof(Translations.Validation_ConfirmPasswordRequired))]
        [LCompare(nameof(Password), nameof(Translations.Validation_PasswordsDoNotMatch))]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
