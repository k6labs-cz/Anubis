@page "/forgot-password"

@using k6labs.Anubis.Localization

@inject UserManager<User> UserManager
@inject AccountEmailService AccountEmails
@inject NavigationManager Navigation

<AppPageTitle Text="@(Translations.Forgot_PageTitle)" />

<Container MaxWidth="28rem">
    <Stack Gap="Gap.Large">
        <Card>
            <Header>
                <Stack Gap="Gap.XSmall">
                    <Typography Variant="TextVariant.Title" As="TextElement.H1">@Translations.Forgot_Title</Typography>
                    <Typography Variant="TextVariant.Small" Tone="Tone.Muted">@Translations.Forgot_Description</Typography>
                </Stack>
            </Header>
            <ChildContent>
                <Stack Gap="Gap.Medium">
                    @if (submitted)
                    {
                        <Alert Severity="AlertSeverity.Success" Title="@Translations.Common_CheckInbox">
                            @Translations.Forgot_Sent
                        </Alert>
                        <Typography Tone="Tone.Muted" Align="TextAlign.Center"><a href="/login">@Translations.Common_BackToSignIn</a></Typography>
                    }
                    else
                    {
                        <EditForm Model="model" method="post" OnValidSubmit="SubmitAsync" FormName="forgot-password">
                            <Stack Gap="Gap.Medium">
                                <DataAnnotationsValidator />

                                <FormText @bind-Value="model.Email" name="model.Email" Label="@Translations.Common_Email" Placeholder="@Translations.Common_EmailPlaceholder" autocomplete="username" autofocus Id="email" Type="email" />

                                <Button Block="true" Type="submit" Icon="@AppIcons.Email">
                                    @Translations.Forgot_Send
                                </Button>
                            </Stack>
                        </EditForm>
                        <Typography Tone="Tone.Muted" Align="TextAlign.Center"><a href="/login">@Translations.Common_BackToSignIn</a></Typography>
                    }
                </Stack>
            </ChildContent>
        </Card>
    </Stack>
</Container>

@code {
    [SupplyParameterFromForm(FormName = "forgot-password")]
    private ForgotPasswordModel model { get; set; } = default!;

    private bool submitted;

    protected override void OnInitialized() => model ??= new();

    private async Task SubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(model.Email);
        if (user is not null)
        {
            await AccountEmails.SendPasswordResetAsync(user, Navigation.BaseUri);
        }

        // Same answer whether or not the account exists, so the form can't be used
        // to find out who has an account.
        submitted = true;
    }

    public sealed class ForgotPasswordModel
    {
        [LRequired(nameof(Translations.Validation_EmailRequired))]
        [LEmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
