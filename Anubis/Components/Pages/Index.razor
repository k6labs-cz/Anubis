@page "/"
@inject NavigationManager Navigation

@* There is no landing page: authenticated users land on their profile, everyone else on the login. *@
@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var state = AuthenticationState is not null
            ? await AuthenticationState
            : new AuthenticationState(new System.Security.Claims.ClaimsPrincipal());
        Navigation.NavigateTo(state.User.Identity?.IsAuthenticated == true ? "/account" : "/login");
    }
}
