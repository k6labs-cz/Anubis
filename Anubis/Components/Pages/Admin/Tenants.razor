@page "/tenants"
@rendermode InteractiveServer
@attribute [Authorize(Roles = DatabaseInitializer.AdminGroup)]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using k6labs.Anubis.Tenancy

@inject TenantAdministration Administration
@inject TenantCatalog Catalog
@inject NavigationManager Navigation
@inject Identity.PasswordPolicy PasswordPolicy
@* Notifications belong to this page and its interactive circuit. *@

<AppPageTitle Text="@(Translations.Common_AdminPageTitle.F(Translations.Admin_Tenants))" />

@if (!TenantContext.Current.IsDefault)
{
    @* Tenants are managed from the default tenant; to the others the page does not exist. *@
    <Alert Severity="AlertSeverity.Neutral" Title="@Translations.Routes_NotFoundTitle">
        @Translations.Routes_NotFoundText
    </Alert>
    return;
}

<NotificationList State="Notifications" />

<Stack Gap="Gap.Large">
    <PageHeader Title="@Translations.Admin_Tenants" Description="@Translations.Admin_TenantsDescription"
                CreateLabel="@Translations.Tenants_Create" OnCreate="OpenCreate" />

    <Table Label="@Translations.Admin_Tenants">
        <thead>
            <tr>
                <th>@Translations.Tenants_Id</th>
                <th>@Translations.Common_DisplayName</th>
                <th>@Translations.Tenants_Address</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tenant in tenants)
            {
                <tr>
                    <td>
                        <code>@tenant.Id</code>
                        @if (tenant.IsDefault)
                        {
                            <Badge>@Translations.Tenants_Default</Badge>
                        }
                    </td>
                    <td>@tenant.DisplayName</td>
                    <td>
                        @foreach (var host in Addresses(tenant))
                        {
                            <div><a href="@Address(host)" rel="noopener" target="_blank">@host</a></div>
                        }
                    </td>
                    <td data-align="end">
                        @if (!tenant.IsDefault)
                        {
                            <RowMenu>
                                <MenuItem Icon="@AppIcons.Edit" OnClick="() => OpenEdit(tenant)" data-popup-option>@Translations.Common_Edit</MenuItem>
                                <MenuItem Icon="@AppIcons.Delete" OnClick="() => AskDelete(tenant)" data-popup-option Danger="true">@Translations.Common_Delete</MenuItem>
                            </RowMenu>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </Table>
</Stack>

<AppModal Title="@Translations.Tenants_Create" @bind-Open="createOpen">
    <ChildContent>
        <EditForm Model="createModel" OnValidSubmit="CreateAsync" FormName="createTenant" id="createTenantForm">
            <Stack Gap="Gap.Medium">
                <FormText @bind-Value="createModel.Id" Label="@Translations.Tenants_Id" Placeholder="acme" Id="tenantId" maxlength="@Tenant.IdMaxLength" />
                <FormText @bind-Value="createModel.DisplayName" Label="@Translations.Common_DisplayName" Id="tenantDisplayName" maxlength="@Tenant.DisplayNameMaxLength" />
                <FormText @bind-Value="createModel.Hosts" Label="@Translations.Tenants_Hosts" Placeholder="@("login.acme.com")" Id="tenantHosts"
                          Hint="@Translations.Tenants_HostsHint.F($"{(string.IsNullOrWhiteSpace(createModel.Id) ? "acme" : createModel.Id.Trim())}.{Catalog.Domain}")" />
                <FormText @bind-Value="createModel.AdminEmail" Label="@Translations.Tenants_AdminEmail" Placeholder="@Translations.Common_EmailPlaceholder" Id="tenantAdminEmail" Type="email" />
                <FormText @bind-Value="createModel.AdminPassword" Label="@Translations.Tenants_AdminPassword" Placeholder="@Translations.Common_NewPasswordPlaceholder.F(PasswordPolicy.MinLength)" Id="tenantAdminPassword" Type="password" autocomplete="new-password" />
                @if (formError is not null)
                {
                    <Alert Severity="AlertSeverity.Danger">@formError</Alert>
                }
            </Stack>
        </EditForm>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Text" OnClick="() => createOpen = false">@Translations.Common_Cancel</Button>
        <Button form="createTenantForm" Disabled="busy" Type="submit">@Translations.Tenants_Create</Button>
    </Footer>
</AppModal>

<AppModal Title="@Translations.Common_Edit" @bind-Open="editOpen">
    <ChildContent>
        <EditForm Model="editModel" OnValidSubmit="SaveAsync" FormName="editTenant" id="editTenantForm">
            <Stack Gap="Gap.Medium">
                <FormText Value="@editModel.Id" Label="@Translations.Tenants_Id" Id="editTenantId" ReadOnly="true" />
                <FormText @bind-Value="editModel.DisplayName" Label="@Translations.Common_DisplayName" Id="editTenantDisplayName" maxlength="@Tenant.DisplayNameMaxLength" />
                <FormText @bind-Value="editModel.Hosts" Label="@Translations.Tenants_Hosts" Placeholder="@("login.acme.com")" Id="editTenantHosts"
                          Hint="@Translations.Tenants_HostsHint.F($"{editModel.Id}.{Catalog.Domain}")" />
                @if (formError is not null)
                {
                    <Alert Severity="AlertSeverity.Danger">@formError</Alert>
                }
            </Stack>
        </EditForm>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Text" OnClick="() => editOpen = false">@Translations.Common_Cancel</Button>
        <Button form="editTenantForm" Disabled="busy" Type="submit">@Translations.Common_Save</Button>
    </Footer>
</AppModal>

<AppModal Title="@Translations.Common_Delete" @bind-Open="deleteOpen">
    <ChildContent>
        <Typography>@Translations.Tenants_DeleteConfirm.F(tenantToDelete?.Id)</Typography>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Text" OnClick="() => deleteOpen = false">@Translations.Common_Cancel</Button>
        <Button Variant="ButtonVariant.Danger" OnClick="DeleteAsync">@Translations.Common_Delete</Button>
    </Footer>
</AppModal>

@code {
    private sealed class TenantForm
    {
        public string? Id { get; set; }
        public string? DisplayName { get; set; }

        /// <summary>Host names separated by spaces, commas or new lines.</summary>
        public string? Hosts { get; set; }
        public string? AdminEmail { get; set; }
        public string? AdminPassword { get; set; }

        public string[] HostList => (Hosts ?? string.Empty).Split([' ', ',', ';', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private readonly NotificationState Notifications = new();
    private TenantForm createModel = new();
    private TenantForm editModel = new();
    private IReadOnlyList<Tenant> tenants = [];
    private bool createOpen;
    private bool editOpen;
    private string? formError;
    private Tenant? tenantToDelete;
    private bool deleteOpen;
    private bool busy;

    protected override void OnInitialized() => tenants = Administration.List();

    /// <summary>Where the tenant is reached: its own host names and its subdomain; this address for the default tenant.</summary>
    private IEnumerable<string> Addresses(Tenant tenant)
        => tenant.IsDefault ? [new Uri(Navigation.BaseUri).Host] : tenant.Hosts.Append(Administration.Subdomain(tenant));

    /// <summary>The address of this page with the tenant's host name (the same scheme and port).</summary>
    private string Address(string host) => new UriBuilder(Navigation.BaseUri) { Host = host }.Uri.AbsoluteUri;

    private void OpenCreate()
    {
        createModel = new TenantForm();
        formError = null;
        createOpen = true;
    }

    private void OpenEdit(Tenant tenant)
    {
        editModel = new TenantForm { Id = tenant.Id, DisplayName = tenant.DisplayName, Hosts = string.Join(' ', tenant.Hosts) };
        formError = null;
        editOpen = true;
    }

    private Task CreateAsync() => SubmitAsync(async () =>
    {
        // A tenant without an administrator would belong to whoever registers in it first.
        if (string.IsNullOrWhiteSpace(createModel.AdminEmail) || string.IsNullOrEmpty(createModel.AdminPassword))
        {
            throw new TenantAdministrationException(TenantError.Invalid, Translations.Error_TenantAdminRequired);
        }

        var created = await Administration.CreateAsync(createModel.Id, createModel.DisplayName, createModel.HostList,
            new TenantAdministrator(createModel.AdminEmail.Trim(), createModel.AdminPassword));
        createOpen = false;
        Notifications.Add(Translations.Users_CreatedText.F(created.Id), AlertSeverity.Success);
    });

    private Task SaveAsync() => SubmitAsync(async () =>
    {
        await Administration.UpdateAsync(editModel.Id!, editModel.DisplayName, editModel.HostList);
        editOpen = false;
    });

    /// <summary>Runs a form's change; a refusal shows in the form.</summary>
    private async Task SubmitAsync(Func<Task> change)
    {
        busy = true;
        formError = null;
        try
        {
            await change();
            tenants = Administration.List();
        }
        catch (TenantAdministrationException exception)
        {
            formError = exception.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void AskDelete(Tenant tenant)
    {
        tenantToDelete = tenant;
        deleteOpen = true;
    }

    private async Task DeleteAsync()
    {
        if (tenantToDelete is null)
        {
            return;
        }

        deleteOpen = false;
        try
        {
            await Administration.DeleteAsync(tenantToDelete.Id);
            Notifications.Add(Translations.Users_DeletedText.F(tenantToDelete.Id), AlertSeverity.Success);
            tenants = Administration.List();
        }
        catch (TenantAdministrationException exception)
        {
            Notifications.Add(exception.Message, AlertSeverity.Danger);
        }

        tenantToDelete = null;
    }
}
