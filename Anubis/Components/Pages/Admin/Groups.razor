@page "/groups"
@rendermode InteractiveServer
@attribute [Authorize(Roles = DatabaseInitializer.AdminGroup)]

@using k6labs.Anubis.Localization
@using Microsoft.AspNetCore.Authorization

@inject RoleManager<Group> RoleManager
@inject UserManager<User> UserManager
@* Notifications belong to this page and its interactive circuit. *@
@inject Services.GroupAdministration Administration

<AppPageTitle Text="@(Translations.Common_AdminPageTitle.F(Translations.Admin_Groups))" />

<NotificationList State="Notifications" />

<Stack Gap="Gap.Large">
    <PageHeader Title="@Translations.Admin_Groups" Description="@Translations.Admin_GroupsDescription"
                CreateLabel="@Translations.Groups_Create" OnCreate="OpenCreate" />

    <Table Label="@Translations.Admin_Groups">
        <thead>
            <tr>
                <th>@Translations.Common_Name</th>
                <th>@Translations.Groups_Members</th>
                <th>@Translations.Claims_Title</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in groups)
            {
                <tr>
                    <td>
                        <code>@group.Name</code>
                        @if (IsBuiltIn(group))
                        {
                            <Badge>@Translations.Groups_BuiltIn</Badge>
                        }
                    </td>
                    <td>@members[group.Id].Count</td>
                    <td>@claimCounts.GetValueOrDefault(group.Id)</td>
                    <td data-align="end">
                        <RowMenu>
                            <MenuItem Icon="@AppIcons.Edit" OnClick="() => OpenEditAsync(group)" data-popup-option>@Translations.Common_Edit</MenuItem>
                            <Divider />
                            <MenuItem Icon="@AppIcons.Group" OnClick="() => OpenMembers(group)" data-popup-option>@Translations.Groups_Members</MenuItem>
                            @if (!IsBuiltIn(group))
                            {
                                <Divider />
                                <MenuItem Icon="@AppIcons.Delete" OnClick="() => AskDelete(group)" data-popup-option Danger="true">@Translations.Common_Delete</MenuItem>
                            }
                        </RowMenu>
                    </td>
                </tr>
            }
        </tbody>
    </Table>
</Stack>

<AppModal Title="@Translations.Groups_Create" @bind-Open="createOpen">
    <ChildContent>
        <EditForm Model="createModel" OnValidSubmit="CreateAsync" FormName="createGroup" id="createGroupForm">
            <Stack Gap="Gap.Medium">
                <DataAnnotationsValidator />
                <Typography Variant="TextVariant.Small" Tone="Tone.Muted">@Translations.Groups_CreateDescription</Typography>
                <FormText @bind-Value="createModel.Name" Label="@Translations.Common_Name" Placeholder="@("editors")" Id="groupName" />
                @if (createError is not null)
                {
                    <Alert Severity="AlertSeverity.Danger">@createError</Alert>
                }
            </Stack>
        </EditForm>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Text" OnClick="() => createOpen = false">@Translations.Common_Cancel</Button>
        <Button form="createGroupForm" Disabled="busy" Type="submit">@Translations.Groups_Create</Button>
    </Footer>
</AppModal>

<AppModal Title="@Translations.Groups_EditTitle.F(editingName)" @bind-Open="editOpen">
    <ChildContent>
        @if (editModel is not null)
        {
            <EditForm Model="editModel" OnSubmit="SaveEditAsync" FormName="editGroup" id="editGroupForm">
                <Stack Gap="Gap.Medium">
                    <FormText @bind-Value="editModel.Name" Label="@Translations.Common_Name" Disabled="editModel.BuiltIn" Error="@editErrors.ContainsKey("Name")" ErrorText="@editErrors.GetValueOrDefault("Name")" Id="editGroupName" Hint="@(editModel.BuiltIn ? Translations.Groups_BuiltInName : null)" maxlength="@Services.GroupAdministration.NameMaxLength" />
                    <Divider />
                    <ClaimsEditor Claims="editModel.Claims" Errors="editErrors" Hint="@Translations.Claims_GroupHint" IdPrefix="groupClaim" />
                    @if (editErrors.GetValueOrDefault(string.Empty) is { } formError)
                    {
                        <Alert Severity="AlertSeverity.Danger">@formError</Alert>
                    }
                </Stack>
            </EditForm>
        }
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Text" OnClick="() => editOpen = false">@Translations.Common_Cancel</Button>
        <Button form="editGroupForm" Disabled="@(busy || !editSnapshot.IsDirty(editModel))" Type="submit">@Translations.Common_Save</Button>
    </Footer>
</AppModal>

<AppModal Title="@Translations.Groups_MembersTitle.F(selectedGroup?.Name)" @bind-Open="membersDialogOpen">
    <ChildContent>
        <Stack Gap="Gap.Medium">
            @if (memberError is not null)
            {
                <Alert Severity="AlertSeverity.Danger">@memberError</Alert>
            }

            <Stack Direction="Direction.Row" Gap="Gap.Medium" Align="Align.Start" Wrap="true">
                <Stack Gap="Gap.XSmall" Grow="true">
                    <FormText @bind-Value="newMemberEmail" Label="@Translations.Common_Email" Placeholder="@Translations.Common_EmailPlaceholder" Id="memberEmail" Type="email" />
                </Stack>
                <Button OnClick="AddMemberAsync" Icon="@AppIcons.PersonAdd">
                    @Translations.Groups_AddMember
                </Button>
            </Stack>

            @if (selectedGroup is not null && members[selectedGroup.Id].Count > 0)
            {
                <Table Label="@Translations.Groups_Members" Dense="true">
                    <tbody>
                        @foreach (var member in members[selectedGroup.Id])
                        {
                            <tr>
                                <td>@member.Email</td>
                                <td>@member.DisplayName</td>
                                <td data-align="end">
                                    <RowMenu>
                                        <MenuItem Icon="@AppIcons.PersonRemove" OnClick="() => RemoveMemberAsync(member)" data-popup-option Danger="true">@Translations.Groups_RemoveMember</MenuItem>
                                    </RowMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </Table>
            }
            else
            {
                <Typography Variant="TextVariant.Small" Tone="Tone.Muted">@Translations.Groups_NoMembers</Typography>
            }
        </Stack>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Ghost" OnClick="() => membersDialogOpen = false">@Translations.Common_Close</Button>
    </Footer>
</AppModal>

<AppModal Title="@Translations.Groups_DeleteTitle" @bind-Open="deleteDialogOpen">
    <ChildContent>
        <Typography>@Translations.Groups_DeleteConfirm.F(groupToDelete?.Name)</Typography>
    </ChildContent>
    <Footer>
        <Button Variant="ButtonVariant.Ghost" OnClick="() => deleteDialogOpen = false">@Translations.Common_Cancel</Button>
        <Button Variant="ButtonVariant.Danger" OnClick="DeleteAsync">@Translations.Common_Delete</Button>
    </Footer>
</AppModal>

@code {
    private readonly NotificationState Notifications = new();
    private GroupFormModel createModel = new();
    private bool createOpen;
    private string? createError;
    private List<Group> groups = new();
    private Dictionary<string, List<User>> members = new();
    private Group? selectedGroup;
    private bool membersDialogOpen;
    private string? newMemberEmail;
    private string? memberError;
    private Group? groupToDelete;
    private bool deleteDialogOpen;
    private bool busy;
    private Dictionary<string, int> claimCounts = new();
    private Models.GroupEditModel? editModel;
    private string? editingName;
    private bool editOpen;
    private readonly FormSnapshot editSnapshot = new();
    private Dictionary<string, string> editErrors = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private static bool IsBuiltIn(Group group)
        => group.Name is DatabaseInitializer.AdminGroup or DatabaseInitializer.UserGroup;

    private async Task LoadAsync()
    {
        groups = await RoleManager.Roles.OrderBy(r => r.Name).ToListAsync();
        members = new Dictionary<string, List<User>>();
        claimCounts = new Dictionary<string, int>();
        foreach (var group in groups)
        {
            claimCounts[group.Id] = (await RoleManager.GetClaimsAsync(group)).Count(claim => !Services.CustomClaims.IsReserved(claim.Type));
            members[group.Id] = (await UserManager.GetUsersInRoleAsync(group.Name!)).OrderBy(u => u.Email).ToList();
        }

        if (selectedGroup is not null)
        {
            selectedGroup = groups.FirstOrDefault(r => r.Id == selectedGroup.Id);
        }
    }

    private void OpenCreate()
    {
        createModel = new GroupFormModel();
        createError = null;
        createOpen = true;
    }

    private async Task CreateAsync()
    {
        busy = true;
        createError = null;

        var name = createModel.Name.Trim();
        var result = await RoleManager.CreateAsync(new Group(name));
        busy = false;

        if (!result.Succeeded)
        {
            createError = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        createOpen = false;
        Notifications.Add(Translations.Users_CreatedText.F(name), AlertSeverity.Success);
        await LoadAsync();
    }

    private async Task OpenEditAsync(Group group)
    {
        editModel = await Administration.LoadAsync(group.Id);
        if (editModel is null)
        {
            Notifications.Add(Translations.Groups_NotFound, AlertSeverity.Danger);
            await LoadAsync();
            return;
        }

        editingName = editModel.Name;
        editErrors = new();
        editSnapshot.Take(editModel);
        editOpen = true;
    }

    private async Task SaveEditAsync()
    {
        if (editModel is null)
        {
            return;
        }

        busy = true;
        editErrors = await Administration.UpdateAsync(editModel);
        busy = false;
        if (editErrors.Count > 0)
        {
            return;
        }

        editOpen = false;
        Notifications.Add(Translations.Groups_Saved.F(editModel.Name.Trim()), AlertSeverity.Success);
        await LoadAsync();
    }

    private void OpenMembers(Group group)
    {
        selectedGroup = group;
        newMemberEmail = null;
        memberError = null;
        membersDialogOpen = true;
    }

    private async Task AddMemberAsync()
    {
        memberError = null;
        if (selectedGroup is null || string.IsNullOrWhiteSpace(newMemberEmail))
        {
            return;
        }

        var user = await UserManager.FindByEmailAsync(newMemberEmail.Trim());
        if (user is null)
        {
            memberError = Translations.Common_UserNotFound;
            return;
        }

        if (!await UserManager.IsInRoleAsync(user, selectedGroup.Name!))
        {
            var result = await UserManager.AddToRoleAsync(user, selectedGroup.Name!);
            if (!result.Succeeded)
            {
                memberError = string.Join(" ", result.Errors.Select(e => e.Description));
                return;
            }
        }

        newMemberEmail = null;
        await LoadAsync();
    }

    private async Task RemoveMemberAsync(User user)
    {
        memberError = null;
        if (selectedGroup is null)
        {
            return;
        }

        // Never lock everybody out of the admin section.
        if (selectedGroup.Name == DatabaseInitializer.AdminGroup && members[selectedGroup.Id].Count <= 1)
        {
            memberError = Translations.Groups_LastAdmin;
            return;
        }

        var result = await UserManager.RemoveFromRoleAsync(user, selectedGroup.Name!);
        if (!result.Succeeded)
        {
            memberError = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        // Group changes take effect on the user's next sign-in / token refresh.
        await UserManager.UpdateSecurityStampAsync(user);
        await LoadAsync();
    }

    private void AskDelete(Group group)
    {
        groupToDelete = group;
        deleteDialogOpen = true;
    }

    private async Task DeleteAsync()
    {
        if (groupToDelete is null || IsBuiltIn(groupToDelete))
        {
            deleteDialogOpen = false;
            return;
        }

        var result = await RoleManager.DeleteAsync(groupToDelete);
        deleteDialogOpen = false;

        if (result.Succeeded)
        {
            Notifications.Add(Translations.Users_DeletedText.F(groupToDelete.Name), AlertSeverity.Success);
        }
        else
        {
            Notifications.Add(string.Join(" ", result.Errors.Select(e => e.Description)), AlertSeverity.Danger);
        }

        groupToDelete = null;
        await LoadAsync();
    }

    private sealed class GroupFormModel
    {
        [LRequired(nameof(Translations.Validation_GroupNameRequired))]
        [LRegularExpression(@"^[a-zA-Z0-9\-_\.]+$", nameof(Translations.Validation_Identifier))]
        [LStringLength(100, nameof(Translations.Validation_NameTooLong))]
        public string Name { get; set; } = string.Empty;
    }
}
